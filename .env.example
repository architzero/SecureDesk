# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Your Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# Any current Groq chat model. Check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

MAX_UPLOAD_MB=5
DISPLAY_TIMEZONE=Asia/Kolkata

# Secure by default (F16). Browsers still send Secure cookies to http://localhost,
# so leave this at 1. Set to 0 only if a specific browser refuses the cookie locally.
SESSION_COOKIE_SECURE=1
# Debug is OFF by default (F5). Never set this to 1 on anything reachable from a network.
FLASK_DEBUG=0


